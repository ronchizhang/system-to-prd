{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "module/1.0",
  "engine": "system-to-prd@2.0",
  "type": "object",
  "required": [
    "schema",
    "engine",
    "meta",
    "sources",
    "sections",
    "rules",
    "transitions",
    "apis",
    "questions",
    "dialogs",
    "context",
    "entities",
    "layout",
    "prototype",
    "facts"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "module/1.0"
    },
    "engine": {
      "type": "string",
      "const": "system-to-prd@2.0",
      "hint": "生成器版本。合并全量 PRD 时要求全员一致，防止有人用旧版 skill"
    },
    "meta": {
      "type": "object",
      "required": [
        "key",
        "module",
        "menu",
        "route",
        "system",
        "env",
        "date",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9\\-]{2,40}$",
          "hint": "全局唯一模块 key，如 ops-person-field。合并时用它排序与去重"
        },
        "system": {
          "type": "string",
          "enum": [
            "管理后台",
            "企业端",
            "员工端"
          ]
        },
        "module": {
          "type": "string",
          "minLength": 2,
          "hint": "模块名，如 人员字段配置"
        },
        "menu": {
          "type": "string",
          "minLength": 2,
          "hint": "三级菜单全路径，如 人员管理 / 人员字段配置"
        },
        "route": {
          "type": "string",
          "minLength": 3
        },
        "env": {
          "type": "string",
          "minLength": 3,
          "hint": "必须写明是测试环境"
        },
        "customer": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "version": {
          "type": "string",
          "minLength": 2
        },
        "rev": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "draft": {
          "type": "integer",
          "minimum": 1,
          "hint": "本稿稿次（整数）。改动编号是累积的，没有它分不出「本稿改的」和「前几稿累积的」"
        },
        "owner": {
          "type": "string",
          "hint": "负责人，团队协作时用于回溯"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "hint": "六源必须齐全（浏览器渲染/后端接口/前端代码/后端代码/用例库/业务确认），顺序不限",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status",
          "detail"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2
          },
          "status": {
            "type": "string",
            "enum": [
              "不可达",
              "已核",
              "未核",
              "部分"
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 8,
            "hint": "写清核了什么、拿到什么数字。只写「已核」不算"
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "hint": "固定 8 段，顺序不可改；第 5 段 rules / 第 6 段 statemachine 由数据渲染，html 留空",
      "items": {
        "type": "object",
        "required": [
          "n",
          "title",
          "html"
        ],
        "additionalProperties": false,
        "properties": {
          "n": {
            "type": "integer"
          },
          "title": {
            "type": "string",
            "minLength": 2
          },
          "sub": {
            "type": "string"
          },
          "html": {
            "type": "string"
          },
          "rules": {
            "type": "boolean"
          },
          "statemachine": {
            "type": "boolean"
          },
          "frames": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "hint": "这一段讲到的原型帧编号，如 [\"P1\",\"P2\"]。渲染成段标题右侧的小按钮，点一下切到那一帧——读文档时不用自己回左边找图"
          }
        }
      }
    },
    "context": {
      "type": "string",
      "minLength": 20,
      "hint": "YAML 文本：为什么这样设计。防止 AI 做错误优化"
    },
    "entities": {
      "type": "string",
      "minLength": 20,
      "hint": "YAML 文本：实体、字段、枚举、状态"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "confidence",
          "src",
          "statement",
          "evidence",
          "cases"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R-[A-Z0-9]+-[A-Z0-9]+-\\d{2}$",
            "hint": "R-{系统}-{模块}-{序号}，如 R-OPS-FIELD-01"
          },
          "type": {
            "type": "string",
            "enum": [
              "calculation",
              "constraint",
              "display",
              "layout",
              "permission",
              "principle",
              "transition",
              "validation"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "互证",
              "单源",
              "双证",
              "确立"
            ]
          },
          "src": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "api",
                "be",
                "biz",
                "fe",
                "ima",
                "ui"
              ]
            }
          },
          "statement": {
            "type": "string",
            "minLength": 10,
            "hint": "一句话只讲一个命题，不用代词，不写「等」"
          },
          "evidence": {
            "type": "string",
            "minLength": 6,
            "hint": "具体到接口/文件/用例标题，不写「实测」两字了事"
          },
          "cases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "k",
                "g",
                "w",
                "t"
              ],
              "additionalProperties": false,
              "properties": {
                "k": {
                  "type": "string",
                  "enum": [
                    "conflict",
                    "edge",
                    "negative",
                    "positive"
                  ]
                },
                "g": {
                  "type": "string",
                  "minLength": 4,
                  "hint": "前置 given"
                },
                "w": {
                  "type": "string",
                  "minLength": 2,
                  "hint": "动作 when"
                },
                "t": {
                  "type": "string",
                  "minLength": 4,
                  "hint": "预期 then，必须可判定"
                }
              }
            }
          },
          "note": {
            "type": "string"
          },
          "facts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "hint": "这条规则的依据是哪几条 F-xx。填了叙事里就能点回核查"
          }
        }
      }
    },
    "transitions": {
      "type": "object",
      "required": [
        "states",
        "rows"
      ],
      "additionalProperties": false,
      "properties": {
        "states": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "from",
              "to",
              "trigger",
              "guard",
              "label",
              "kind"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^T\\d+$"
              },
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "trigger": {
                "type": "string",
                "minLength": 2
              },
              "guard": {
                "type": "string"
              },
              "label": {
                "type": "string",
                "minLength": 2,
                "hint": "图上标的字，≤8 字最好"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "back",
                  "danger",
                  "draft",
                  "normal"
                ]
              },
              "api": {
                "type": "string"
              }
            }
          }
        },
        "caption": {
          "type": "string"
        },
        "confidence": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "apis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "method",
          "path",
          "purpose",
          "auth",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "DELETE"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 4
          },
          "purpose": {
            "type": "string",
            "minLength": 2
          },
          "auth": {
            "type": "string",
            "minLength": 2
          },
          "evidence": {
            "type": "string",
            "minLength": 4
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "hint": "至少一条。一条都没有，通常意味着核查不够深",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "why",
          "ask"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^Q-\\d{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 4
          },
          "why": {
            "type": "string",
            "minLength": 10
          },
          "ask": {
            "type": "string",
            "minLength": 4
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "answered"
            ],
            "hint": "闸门 2 通过后，被回答的题要改成 answered 并补 answer"
          },
          "answer": {
            "type": "string"
          }
        }
      }
    },
    "dialogs": {
      "type": "array",
      "minItems": 1,
      "hint": "本模块下的二级页/弹窗/抽屉。一个没有，说明边界没探清",
      "items": {
        "type": "object",
        "required": [
          "type",
          "name",
          "entry",
          "route",
          "covered"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "二级页",
              "分步",
              "弹窗",
              "抽屉"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 2
          },
          "entry": {
            "type": "string",
            "minLength": 2
          },
          "route": {
            "type": "string"
          },
          "covered": {
            "type": "boolean"
          }
        }
      }
    },
    "layout": {
      "type": "string",
      "minLength": 10,
      "hint": "界面结构（列数、控件顺序、尺寸），AI 写代码时缺这段会自己编布局"
    },
    "prototype": {
      "type": "object",
      "required": [
        "viewport",
        "frames"
      ],
      "additionalProperties": false,
      "hint": "本模块的原型帧。主页面 + 每个弹窗/二级页各一帧，缺了等于没画",
      "properties": {
        "viewport": {
          "type": "string",
          "enum": [
            "1280x800",
            "1440x900",
            "1920x1080",
            "390x844"
          ],
          "hint": "设计尺寸。后台统一 1440x900，手机端 390x844"
        },
        "note": {
          "type": "string"
        },
        "frames": {
          "type": "array",
          "minItems": 0,
          "hint": "主页面 + 每个弹窗/二级页各一帧。确实没有界面的模块（定时任务、纯配置、只跑批的后台服务）可以留空，渲染成「本模块未附原型帧」的空态；但交付说明里要写清为什么没有图，别拿它偷懒",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "html"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^P\\d{1,2}$",
                "hint": "P1 主页面、P2 新增、P3 弹窗……页签按这个顺序排"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "ui",
                  "flow",
                  "diagram",
                  "explain"
                ],
                "hint": "帧的性质。ui=实拍界面（默认）；flow=流程/判定逻辑（SVG）；diagram=全景/分层图；explain=界面化说明页（要上线的页）。后三类是生成图，不要求 from，不参与一页一帧的尺寸推算。缺省按 ui 处理，老数据不用补这个字段。"
              },
              "name": {
                "type": "string",
                "minLength": 2,
                "hint": "页面态名，如 字段列表 / 新增字段"
              },
              "state": {
                "type": "string",
                "hint": "这个态是什么：默认态 / 空态 / 校验失败 / 弹窗打开"
              },
              "route": {
                "type": "string"
              },
              "from": {
                "type": "string",
                "hint": "这帧的实拍来源：snapshot/<key>.json#p1。填了就必须有对应快照和截图，验收会查——这是「不许凭印象画」的凭据"
              },
              "note": {
                "type": "string",
                "hint": "看图时必须交代的事：哪些是示例数据、哪里被裁掉了"
              },
              "html": {
                "type": "string",
                "minLength": 20,
                "hint": "原型 HTML 片段。只用 px- 组件 class，不写 style，否则每个人画出来都不一样"
              }
            }
          }
        }
      }
    },
    "testcases": {
      "type": "array",
      "hint": "测试用例规整。从 用例库取回后统一成一种形态，一条一个功能点，标出它验证的是哪条业务规则。没有就留空数组，别编",
      "items": {
        "type": "object",
        "required": [
          "id",
          "group",
          "title",
          "pre",
          "steps",
          "expect"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 3,
            "hint": "沿用用例库编号（如 TC-WDR-012）；没有编号就用 TC-<模块缩写>-序号"
          },
          "group": {
            "type": "string",
            "minLength": 2,
            "hint": "功能点分组：列表 / 筛选 / 详情 / 导出 …，同一组排在一起"
          },
          "title": {
            "type": "string",
            "minLength": 4,
            "hint": "这条用例验什么，一句话"
          },
          "pre": {
            "type": "string",
            "hint": "前提：什么数据、什么账号、什么状态；没有写「无」"
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "hint": "操作步骤，一步一句，不夹断言"
          },
          "expect": {
            "type": "string",
            "minLength": 4,
            "hint": "预期结果，必须可判定（看到什么、变成什么状态）"
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "hint": "这条用例守的是哪几条 R-xxx。填了就能从规则点过来"
          },
          "norule": {
            "type": "string",
            "hint": "确实没有对应规则时写为什么（如「页面通用行为：筛选与分页」）。空着不写会被门禁当成漏挂"
          },
          "src": {
            "type": "string",
            "hint": "用例来源：用例库 / 业务口述 / 本次补写"
          },
          "gap": {
            "type": "string",
            "hint": "用例与现状不一致、或本次改动后必须重写的地方，写在这里"
          }
        }
      }
    },
    "code": {
      "type": "object",
      "hint": "代码逻辑。上半段用大白话讲「这个数谁算的、什么时候算、失败会怎样」，下半段给研发的对照（页面 → 组件 → 接口 → 字段）。两块都要，因为业务方看上半段就能判断对不对，研发看下半段就能动手",
      "additionalProperties": false,
      "properties": {
        "plain": {
          "type": "array",
          "minItems": 1,
          "hint": "大白话段：一段一件事，说清「谁算的 / 什么时候算 / 算不出来怎么办」",
          "items": {
            "type": "object",
            "required": [
              "q",
              "a"
            ],
            "additionalProperties": false,
            "properties": {
              "q": {
                "type": "string",
                "minLength": 4,
                "hint": "业务方真的会问的那句话：这个金额是谁算的？"
              },
              "a": {
                "type": "string",
                "minLength": 8,
                "hint": "大白话回答，不用技术词"
              }
            }
          }
        },
        "fe": {
          "type": "array",
          "hint": "前端对照：页面 / 组件 / 取数 / 校验时机",
          "items": {
            "type": "object",
            "required": [
              "where",
              "what"
            ],
            "additionalProperties": false,
            "properties": {
              "where": {
                "type": "string",
                "minLength": 2,
                "hint": "页面或组件位置"
              },
              "what": {
                "type": "string",
                "minLength": 4,
                "hint": "这个位置做什么、数据从哪来"
              },
              "path": {
                "type": "string",
                "hint": "文件或路由，可留空"
              }
            }
          }
        },
        "be": {
          "type": "array",
          "hint": "后端对照：接口 / 表 / 关键判断",
          "items": {
            "type": "object",
            "required": [
              "where",
              "what"
            ],
            "additionalProperties": false,
            "properties": {
              "where": {
                "type": "string",
                "minLength": 2,
                "hint": "接口或表名"
              },
              "what": {
                "type": "string",
                "minLength": 4,
                "hint": "它做什么、返回什么判定"
              },
              "path": {
                "type": "string",
                "hint": "代码位置，可留空"
              }
            }
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "hint": "技术侧遗留风险：并发、超时、精度… 一条一句"
        }
      }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "hint": "五源事实清单。正文每条规则的 facts 都指向这里；没有这张表，结论就追不到来源",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "area",
          "cls",
          "sev",
          "src",
          "now"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(F|Q)-\\d{2}$",
            "hint": "F-xx 是观察到的事实，Q-xx 是要人回答的问题；两者同表并列"
          },
          "title": {
            "type": "string",
            "minLength": 4,
            "hint": "一句话说清这条事实是什么，不要写「关于xx的问题」"
          },
          "area": {
            "type": "string",
            "minLength": 2,
            "hint": "归属对象：字段类型 / 校验 / 权限…"
          },
          "cls": {
            "type": "string",
            "enum": [
              "add",
              "ask",
              "conflict",
              "fix",
              "ok",
              "risk"
            ],
            "hint": "fix 现有写法要改 / add 漏了要补 / conflict 多源打架 / risk 有隐患 / ask 要裁定 / ok 核过一致"
          },
          "sev": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2"
            ],
            "hint": "P0 不裁定就没法开工；P1 影响写法；P2 表述优化"
          },
          "src": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "api",
                "be",
                "biz",
                "fe",
                "ima",
                "ui"
              ]
            },
            "hint": "这条事实是哪个源给的。至少一个，别写「综合」"
          },
          "old": {
            "type": "string",
            "hint": "原说法。cls=miss 时可空"
          },
